# VisionDetect backend configuration. Copy to .env and edit, or export these
# directly. Every value shown is the default.

# Where model weights are resolved from. Defaults to the repository's models/
# directory, so a checkout that already has weights needs no download.
# VISIONAI_WEIGHTS_DIR=../models

# Model used when a request does not name one.
# VISIONAI_DEFAULT_MODEL=yolo11n

# auto | cpu | cuda. "auto" uses the GPU only if the installed runtime offers
# one. "cuda" fails loudly rather than falling back to CPU silently.
# VISIONAI_DEVICE=auto

# Detection defaults.
# VISIONAI_CONFIDENCE_THRESHOLD=0.35
# VISIONAI_IOU_THRESHOLD=0.45

# Upload limit, in megabytes.
# VISIONAI_MAX_UPLOAD_MB=15

# How long a completed result stays retrievable, in seconds. Uploaded images
# are held in memory for this long so settings can be re-applied without a
# re-upload, then dropped.
# VISIONAI_RESULT_TTL_SECONDS=3600

# Analysis history: metadata only, never images.
# VISIONAI_HISTORY_ENABLED=true
# VISIONAI_HISTORY_DB=data/history.db

# Write uploaded images to data/uploads/. Off by default: an uploaded photo is
# the user's, and closing the server should be enough to be rid of it.
# VISIONAI_PERSIST_UPLOADS=false

# Origins allowed to call the API, comma separated. Only needed when the
# dashboard is served from somewhere other than the Vite dev server.
# VISIONAI_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# A JSON file describing models, replacing the built-in registry. This is how a
# custom-trained checkpoint is added without changing any code.
# VISIONAI_MODELS_FILE=./models.json
