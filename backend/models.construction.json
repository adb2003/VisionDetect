    "name": "yolo11n-pt",
    "backend": "ultralytics",
    "weights": "yolo11n.pt",
    "label": "YOLO11n (COCO, PyTorch)",
    "description": "The same COCO model run through the Ultralytics API. Downloads itself if the checkpoint is absent."
  },
  {
    "name": "ppe-construction",
    "backend": "onnx",
    "weights": "ppe-construction.onnx",
    "label": "Construction PPE (fine-tuned)",
    "description": "YOLOv8 fine-tuned on ~13k construction images: hard hats, vests, gloves, boots, masks and their not-worn counterparts, plus worker, fire extinguisher, welding equipment and circular saw. A trained model rather than prompts, so it detects PPE that open-vocabulary cannot. Apache-2.0, community-trained; run scripts/fetch_model.py to obtain it."
  },
  {
    "name": "construction-hazard",
    "backend": "onnx",
    "weights": "construction-hazard.onnx",
    "label": "Construction hazards (fine-tuned)",
    "description": "YOLO26 fine-tuned for site safety: hardhat, mask, safety vest and their not-worn counterparts, person, safety cone, machinery, vehicle, utility pole. End-to-end head, so no NMS pass is needed. AGPL-3.0 - copyleft, check before shipping. Run scripts/fetch_model.py to obtain it."
  },
